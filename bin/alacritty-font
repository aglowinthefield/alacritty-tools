#!/bin/sh
# alacritty-font — browse and set Alacritty's font, live.
#
# Sibling of alacritty-theme, and built the same way: the font lives in a
# *generated* ~/.config/alacritty/font.toml which alacritty.toml imports, so
# picking a font never edits the chezmoi-managed config and `chezmoi diff`
# stays quiet. (The previous font-preview.sh rewrote alacritty.toml in place
# and kept a .bak to undo itself; this is what replaced it.)
#
# Alacritty live-reloads, so the window redraws as you move through the list —
# you judge a font against your real terminal content, not a specimen sheet.
#
#   alacritty-font                 what is set, and where it came from
#   alacritty-font pick            browse installed monospace families, live
#   alacritty-font list            list them
#   alacritty-font set <family>    set a family
#   alacritty-font size <points>   set the size
#   alacritty-font reset           back to this machine's default
#
# Machine defaults come from font-default.toml, which is templated per host;
# a choice made here is written to overrides.conf and survives reapplies.

set -eu

# launchd and cron hand out a bare PATH, and fc-list is a Homebrew binary on
# macOS. Same trap alacritty-theme hit with tmux.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty"
FONT_FILE="$CONFIG_DIR/font.toml"
DEFAULT_FILE="$CONFIG_DIR/font-default.toml"
OVERRIDES="$CONFIG_DIR/overrides.conf"

# Resolve $0 through any symlinks: install.sh leaves a symlink in ~/.local/bin,
# and share/ has to be found relative to the real script in the checkout, not to
# the symlink. $ALACRITTY_TOOLS_SHARE overrides for an unusual layout.
resolve_self() {
	p=$1
	while [ -L "$p" ]; do
		t=$(readlink "$p")
		case $t in
		/*) p=$t ;;
		*) p=$(dirname "$p")/$t ;;
		esac
	done
	printf '%s\n' "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}
SELF=$(resolve_self "$0")
SHARE=${ALACRITTY_TOOLS_SHARE:-$(dirname "$(dirname "$SELF")")/share}

die() { printf 'alacritty-font: %s\n' "$*" >&2; exit 1; }

# ── state ────────────────────────────────────────────────────────────────────

conf_get() {
	[ -f "$OVERRIDES" ] || return 0
	sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$OVERRIDES" | tail -1
}

conf_set() {
	key=$1 value=$2
	tmp=$(mktemp "$CONFIG_DIR/.overrides.XXXXXX")
	if [ -f "$OVERRIDES" ]; then
		grep -v "^$key[[:space:]]*=" "$OVERRIDES" >"$tmp" || true
	else
		cat >"$tmp" <<-EOF
			# Local choices made by alacritty-theme and alacritty-font. Deleting a
			# line restores that machine's default. Read by the launchd agent,
			# which is why this is a file rather than an environment variable.
		EOF
	fi
	printf '%s = %s\n' "$key" "$value" >>"$tmp"
	mv "$tmp" "$OVERRIDES"
}

conf_unset() {
	[ -f "$OVERRIDES" ] || return 0
	tmp=$(mktemp "$CONFIG_DIR/.overrides.XXXXXX")
	grep -v "^$1[[:space:]]*=" "$OVERRIDES" >"$tmp" || true
	mv "$tmp" "$OVERRIDES"
}

# Pull a value out of a TOML font file. Section-aware, because `size` sits under
# [font] while `family` sits under [font.normal].
toml_get() {
	awk -v want_sect="$2" -v want_key="$3" '
	/^\[/ { sect=$0 }
	sect==want_sect && $0 ~ "^[[:space:]]*" want_key "[[:space:]]*=" {
		line=$0
		sub(/^[^=]*=[[:space:]]*/,"",line)
		gsub(/^"|"$/,"",line)
		sub(/[[:space:]]*(#.*)?$/,"",line)
		print line; exit
	}' "$1" 2>/dev/null
}

# font-default.toml is per-host, so it comes from the dotfiles rather than this
# repo. Without it — a machine not running chezmoi — fall back to something that
# always resolves rather than refusing to generate a font.toml at all.
default_family() { toml_get "$DEFAULT_FILE" "[font.normal]" family | grep . || echo monospace; }
default_size() { toml_get "$DEFAULT_FILE" "[font]" size | grep . || echo 12; }

current_family() { printf '%s\n' "$(conf_get font)" | grep . || default_family; }
current_size() { printf '%s\n' "$(conf_get font_size)" | grep . || default_size; }

# ── generation ───────────────────────────────────────────────────────────────

generate() {
	family=$1 size=$2
	[ -n "$family" ] || die "no font family set and no default in $DEFAULT_FILE"
	[ -n "$size" ] || size=16

	# Skip an identical rewrite: every write costs every open window a reload,
	# and `pick` calls this on each cursor move.
	if [ "$(toml_get "$FONT_FILE" "[font.normal]" family)" = "$family" ] &&
		[ "$(toml_get "$FONT_FILE" "[font]" size)" = "$size" ]; then
		return 0
	fi

	existed=false
	[ -f "$FONT_FILE" ] && existed=true

	tmp=$(mktemp "$CONFIG_DIR/.font.XXXXXX")
	{
		printf '# Generated by alacritty-font — edits are overwritten.\n'
		printf '# Set with `alacritty-font pick`; `alacritty-font reset` restores\n'
		printf '# this machine%s default from font-default.toml.\n\n' "'s"
		printf '[font]\nsize = %s\n\n[font.normal]\nfamily = "%s"\n' "$size" "$family"
	} >"$tmp"
	# Truncate in place rather than rename: same inode, one plain modify event,
	# which is what Alacritty's config watcher wakes up on.
	cat "$tmp" >"$FONT_FILE"
	rm -f "$tmp"

	# An Alacritty that started while font.toml was absent never registered a
	# watch on it — you cannot watch a file that isn't there — so it would
	# ignore every later change, silently. Poking the top-level config, which
	# *is* watched, makes it re-read the import list and pick the file up.
	if [ "$existed" = false ]; then
		touch "$CONFIG_DIR/alacritty.toml" 2>/dev/null || true
	fi
}

apply() { generate "$(current_family)" "$(current_size)"; }

# ── enumeration ──────────────────────────────────────────────────────────────

# fontconfig's own definition of monospace (spacing=100) rather than a guess at
# the name. The old previewer matched /nerd font mono$/, which silently dropped
# "RecMonoCasual Nerd Font" — the family configured on every machine but this
# one, so its own font was missing from its own list.
#
# Take only the FIRST comma-separated value per font. fc-list prints a family's
# aliases too, and splitting on the comma turns every weight into a fake family:
# "BlexMono Nerd Font Light" is an alias of "BlexMono Nerd Font", not something
# you can ask for. On macOS Alacritty resolves through Core Text, which has no
# such family, so picking one logged
#     [ERROR] font FontDesc { name: "...", style: Specific("Regular") } not found
# and left the font unchanged. Measured against Core Text's own family list:
# 429 of the 602 split names did not exist; taking the primary name gives 173
# that do. Leading-dot names are Apple's hidden system faces (.SF NS Mono,
# .LastResort) and are not selectable either.
families() {
	command -v fc-list >/dev/null 2>&1 ||
		die "fc-list not found — install fontconfig (brew install fontconfig / pacman -S fontconfig)"
	fc-list :spacing=100 family |
		cut -d, -f1 |
		sed 's/^[[:space:]]*//; s/[[:space:]]*$//' |
		grep . |
		grep -v '^\.' |
		sort -uf
}

# ── sample ───────────────────────────────────────────────────────────────────

# Everything a monospace font gets judged on, in a column narrow enough for an
# fzf preview pane. Rendered in the terminal's *current* font, which is the
# whole trick: `pick` has already applied the font by the time this draws.
_sample() {
	family=${1:-$(current_family)}
	printf '\033[1m%s\033[0m  \033[2m%spt\033[0m\n\n' "$family" "$(current_size)"

	printf '\033[2mletterforms\033[0m\n'
	printf '  ABCDEFGHIJKLM NOPQRSTUVWXYZ\n'
	printf '  abcdefghijklm nopqrstuvwxyz\n'
	printf '  0123456789 &@$%%#?!*\n\n'

	printf '\033[2mthe ones that trip you up\033[0m\n'
	printf '  0O0O oO0  1lI| il1  rn m  cl d\n'
	printf '  {} [] () <> ;: ,. `"%s\n\n' "'"

	printf '\033[2mcode\033[0m\n'
	printf '  \033[38;5;110mfn\033[0m \033[38;5;108mmain\033[0m() -> \033[38;5;180mResult\033[0m<(), Box<dyn Error>> {\n'
	printf '      \033[38;5;110mlet\033[0m x = vec![\033[38;5;180m1\033[0m, \033[38;5;180m2\033[0m, \033[38;5;180m3\033[0m];\n'
	printf '      \033[38;5;245m// -> => != === <=> |> ::\033[0m\n'
	printf '  }\n\n'

	printf '\033[2mbox drawing\033[0m\n'
	printf '  ┌───┬───┐  ╭───────╮  ═══╦═══\n'
	printf '  │   │   │  │ ▏▎▍▌▋▊ │     ║\n'
	printf '  └───┴───┘  ╰───────╯  ───╨───\n\n'

	printf '\033[2mpowerline + nerd font glyphs\033[0m\n'
	printf '                  \n'
	printf '                     \n\n'

	printf '\033[2mAlacritty does not render ligatures, so -> and =>\033[0m\n'
	printf '\033[2mstay as two glyphs by design.\033[0m\n'
}

# ── commands ─────────────────────────────────────────────────────────────────

status() {
	fam=$(current_family)
	printf '%s  %spt\n' "$fam" "$(current_size)"
	if [ -n "$(conf_get font)" ] || [ -n "$(conf_get font_size)" ]; then
		printf '\033[2mfrom %s (reset to return to %s %spt)\033[0m\n' \
			"$OVERRIDES" "$(default_family)" "$(default_size)"
	else
		printf '\033[2mthis machine%s default, from %s\033[0m\n' "'s" "$DEFAULT_FILE"
	fi
}

pick() {
	command -v fzf >/dev/null 2>&1 || die "pick needs fzf"
	original_family=$(current_family)
	original_size=$(current_size)

	# Start *on* the current font rather than searching for it: seeding --query
	# with the family name filters the list down to that family's own weights
	# (602 families collapse to 14), which looks exactly like a picker that
	# knows only one font. --sync so the list is fully loaded before pos() runs.
	list=$(families)
	idx=$(printf '%s\n' "$list" | grep -nxF "$original_family" | head -1 | cut -d: -f1) || true
	[ -n "${idx:-}" ] || idx=1

	chosen=$(printf '%s\n' "$list" | fzf --sync \
		--prompt='font > ' \
		--header='live preview — enter keeps, esc restores' \
		--bind="start:pos($idx)" \
		--preview="$SELF _sample {}" --preview-window=right,58%,border-left \
		--bind="focus:execute-silent($SELF _preview {})") || true

	if [ -n "$chosen" ]; then
		conf_set font "$chosen"
		apply
		printf 'kept %s\n' "$chosen"
	else
		generate "$original_family" "$original_size"
		printf 'restored %s\n' "$original_family"
	fi
}

case "${1:-}" in
"" | status) status ;;
apply) apply ;;
list) families ;;
pick) pick ;;
set)
	[ $# -ge 2 ] || die "set needs a family name"
	shift
	fam="$*"
	# Warn but obey: a family fontconfig cannot see may still be a real font
	# Alacritty resolves, and being wrong here should not block you.
	if command -v fc-list >/dev/null 2>&1 && ! families | grep -qxF "$fam"; then
		printf 'alacritty-font: warning: no installed monospace family named "%s"\n' "$fam" >&2
	fi
	conf_set font "$fam"
	apply
	printf 'set %s\n' "$fam"
	;;
size)
	[ $# -ge 2 ] || die "size needs a number"
	case $2 in
	'' | *[!0-9.]*) die "size must be a number, got \"$2\"" ;;
	esac
	conf_set font_size "$2"
	apply
	printf 'set %spt\n' "$2"
	;;
reset)
	conf_unset font
	conf_unset font_size
	apply
	printf 'reset to %s %spt\n' "$(default_family)" "$(default_size)"
	;;
_preview)
	generate "$2" "$(current_size)"
	;;
_sample) _sample "${2:-}" ;;
-h | --help) sed -n '11,17p' "$0" | sed 's/^# \{0,1\}//' ;;
*) sed -n '11,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
