#!/bin/sh
# alacritty-theme — switch the terminal stack between the dark and light palette.
#
# Alacritty has no light/dark mode: it loads one palette and that is that. The
# switch is a *generated* ~/.config/alacritty/theme.toml which alacritty.toml
# imports at a fixed path; rewriting it makes live_config_reload repaint every
# open window. alacritty.toml itself is never touched, so the chezmoi-managed
# file stays clean and `chezmoi diff` stays quiet. (font-preview.sh predates
# this and does edit alacritty.toml in place — don't copy that pattern.)
#
# tmux-dotbar rides along the same way — ~/.tmux/theme.conf — because the status
# bar is supposed to share the terminal's background, and a dark bar on a light
# terminal draws exactly the line the theme is built to avoid.
#
# herdr is *not* driven from here: its own [theme] auto_switch follows the host
# terminal's appearance, so repainting Alacritty is all it needs.
#
#   alacritty-theme dark | light   set a variant
#   alacritty-theme toggle         flip to the other one
#   alacritty-theme auto           follow the macOS system appearance
#   alacritty-theme pick [variant] browse every installed theme, live
#   alacritty-theme status         print the current variant and its sources
#
# `dark` and `light` are exactly the words dark-notify passes as $1, so the
# com.tauty.alacritty-theme launchd agent runs this with no wrapper.

set -eu

# launchd hands the agent a bare PATH (/usr/bin:/bin:/usr/sbin:/sbin), so
# Homebrew's tmux is invisible when dark-notify triggers this — and it fails
# *silently*, because theme.conf on disk still updates and only the live
# re-source is skipped. Put the usual prefixes back.
PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty"
THEME_FILE="$CONFIG_DIR/theme.toml"
OVERRIDES="$CONFIG_DIR/overrides.conf"
TMUX_DIR="$HOME/.tmux"
TMUX_THEME_FILE="$TMUX_DIR/theme.conf"

# Resolve $0 through any symlinks: install.sh leaves a symlink in ~/.local/bin,
# and share/ has to be found relative to the real script in the checkout, not to
# the symlink. $ALACRITTY_TOOLS_SHARE overrides for an unusual layout.
resolve_self() {
	p=$1
	while [ -L "$p" ]; do
		t=$(readlink "$p")
		case $t in
		/*) p=$t ;;
		*) p=$(dirname "$p")/$t ;;
		esac
	done
	printf '%s\n' "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")"
}
SELF=$(resolve_self "$0")
SHARE=${ALACRITTY_TOOLS_SHARE:-$(dirname "$(dirname "$SELF")")/share}

# Defaults, overridable two ways: $ALACRITTY_THEME_DARK/_LIGHT for a one-off,
# and overrides.conf — written by `pick`, and shared with alacritty-font — for
# something that has to survive into the launchd agent, which inherits no shell
# environment at all.
#
# Dark is kanagawa_dragon from the alacritty-theme checkout in the Alacritty
# config dir: #181616, deliberately the same as @tmux-dotbar-bg, so don't
# quietly swap it for wave (#1f1f28) without changing that too. Light is
# kanagawa-lotus from this repo's share/colors — the same palette's own light
# half, and the theme herdr switches itself to.
DEFAULT_DARK="$CONFIG_DIR/themes/themes/kanagawa_dragon.toml"
DEFAULT_LIGHT="$SHARE/colors/kanagawa-lotus.toml"

conf_get() {
	[ -f "$OVERRIDES" ] || return 0
	sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$OVERRIDES" | tail -1
}

conf_set() {
	key=$1 value=$2
	tmp=$(mktemp "$CONFIG_DIR/.variants.XXXXXX")
	if [ -f "$OVERRIDES" ]; then
		grep -v "^$key[[:space:]]*=" "$OVERRIDES" >"$tmp" || true
	else
		cat >"$tmp" <<-EOF
			# Local choices made by alacritty-theme and alacritty-font. Deleting a
			# line restores that machine's default. Read by the launchd agent,
			# which is why this is a file rather than an environment variable.
		EOF
	fi
	printf '%s = %s\n' "$key" "$value" >>"$tmp"
	mv "$tmp" "$OVERRIDES"
}

source_for() {
	case $1 in
	dark) printf '%s\n' "${ALACRITTY_THEME_DARK:-$(conf_get dark)}" | grep . || printf '%s\n' "$DEFAULT_DARK" ;;
	light) printf '%s\n' "${ALACRITTY_THEME_LIGHT:-$(conf_get light)}" | grep . || printf '%s\n' "$DEFAULT_LIGHT" ;;
	esac
}

default_for() {
	case $1 in
	dark) printf '%s\n' "$DEFAULT_DARK" ;;
	light) printf '%s\n' "$DEFAULT_LIGHT" ;;
	esac
}

# Both generated files carry their provenance in the first two lines; that
# marker is the only state this thing keeps.
variant_of() { sed -n '1s/^# variant: //p' "$1" 2>/dev/null | grep -E '^(dark|light)$' || echo unknown; }
source_of() { sed -n '2s/^# Generated by alacritty-theme from \(.*\) — edits.*/\1/p' "$1" 2>/dev/null; }

generate() {
	dest=$1 variant=$2 source=$3
	tmp=$(mktemp "$(dirname "$dest")/.theme.XXXXXX")
	{
		printf '# variant: %s\n' "$variant"
		printf '# Generated by alacritty-theme from %s — edits are overwritten.\n\n' "$source"
		cat "$source"
	} >"$tmp"
	# Truncate in place rather than rename into place: same inode, one plain
	# modify event, which is what Alacritty's config watcher wakes up on.
	cat "$tmp" >"$dest"
	rm -f "$tmp"
}

alacritty_apply() {
	variant=$1
	source=${2:-$(source_for "$variant")}

	# A missing import fails *silently* in Alacritty — you get the default
	# #181818 and no error — so refuse to generate a theme.toml built from a
	# file that isn't there.
	if [ ! -f "$source" ]; then
		printf 'alacritty-theme: no %s theme at %s\n' "$variant" "$source" >&2
		exit 1
	fi

	# Rewriting an identical theme would reload every window for nothing, and
	# dark-notify fires this once at login regardless of whether anything moved.
	# Both halves matter: `pick` changes the source without changing the variant.
	if [ "$(variant_of "$THEME_FILE")" = "$variant" ] &&
		[ "$(source_of "$THEME_FILE")" = "$source" ] && [ -s "$THEME_FILE" ]; then
		return 0
	fi

	existed=false
	[ -f "$THEME_FILE" ] && existed=true
	generate "$THEME_FILE" "$variant" "$source"

	# An Alacritty that started while theme.toml was absent never registered a
	# watch on it — you cannot watch a file that isn't there — so it ignores
	# every switch from then on and keeps whatever it loaded, silently. Poking
	# the top-level config, which *is* watched, makes it re-read the import list
	# and pick the file up. Only on creation: doing it every time would reload
	# each window twice.
	if [ "$existed" = false ]; then
		touch "$CONFIG_DIR/alacritty.toml" 2>/dev/null || true
	fi
}

# The two curated dotbar palettes (share/tmux) are hand-tuned and only valid for
# the default themes. Any other theme gets its bar derived from the theme file itself, by
# blending foreground toward background — mechanical, but it holds the "the bar
# shares the terminal's background" rule across all 156 themes.
derive_dotbar() {
	awk '
	function h2d(s,   i,n,d) { n=0
		for (i=1;i<=length(s);i++) { d=index("0123456789abcdef",tolower(substr(s,i,1)))-1; n=n*16+d }
		return n }
	function mix(a,b,t,   i,ca,cb,out,v) { out="#"
		for (i=0;i<3;i++) { ca=h2d(substr(a,2+2*i,2)); cb=h2d(substr(b,2+2*i,2))
			v=int(ca+(cb-ca)*t+0.5); out=out sprintf("%02x",v) }
		return out }
	/^\[/ { sect=$0 }
	match($0,/#[0-9a-fA-F]{6}/) { c=substr($0,RSTART,RLENGTH)
		if (sect=="[colors.primary]" && $0 ~ /background/ && bg=="") bg=c
		if (sect=="[colors.primary]" && $0 ~ /foreground/ && fg=="") fg=c
		if (sect=="[colors.normal]"  && $0 ~ /cyan/       && cy=="") cy=c }
	END {
		if (bg=="" || fg=="") exit 1
		if (cy=="") cy=fg
		printf "set -g @tmux-dotbar-bg          \"%s\"\n", bg
		printf "set -g @tmux-dotbar-fg          \"%s\"\n", mix(fg,bg,0.55)
		printf "set -g @tmux-dotbar-fg-current  \"%s\"\n", fg
		printf "set -g @tmux-dotbar-fg-session  \"%s\"\n", mix(fg,bg,0.30)
		printf "set -g @tmux-dotbar-fg-prefix   \"%s\"\n", cy
	}' "$1"
}

tmux_apply() {
	variant=$1
	source=${2:-$(source_for "$variant")}
	curated="$SHARE/tmux/dotbar-$variant.conf"

	# Not every machine that runs this has the tmux config applied; that is a
	# reason to skip tmux, not to fail the terminal switch.
	[ -d "$TMUX_DIR" ] || return 0

	if [ "$source" = "$(default_for "$variant")" ] && [ -f "$curated" ]; then
		palette_src="$curated"
		palette=$(cat "$curated")
	else
		palette_src="$source"
		palette=$(derive_dotbar "$source" 2>/dev/null) || return 0
		[ -n "$palette" ] || return 0
	fi

	if [ "$(variant_of "$TMUX_THEME_FILE")" != "$variant" ] ||
		[ "$(source_of "$TMUX_THEME_FILE")" != "$palette_src" ] || [ ! -s "$TMUX_THEME_FILE" ]; then
		tmp=$(mktemp "$TMUX_DIR/.theme.XXXXXX")
		{
			printf '# variant: %s\n' "$variant"
			printf '# Generated by alacritty-theme from %s — edits are overwritten.\n\n' "$palette_src"
			printf '%s\n' "$palette"
		} >"$tmp"
		cat "$tmp" >"$TMUX_THEME_FILE"
		rm -f "$tmp"
	fi

	# A running server has already read the old palette and will not look again
	# on its own, so the bar would stay dark until the next server restart.
	if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
		tmux source-file "$TMUX_THEME_FILE" >/dev/null 2>&1 || true
		tmux refresh-client -S >/dev/null 2>&1 || true
	fi
}

set_variant() {
	alacritty_apply "$1" "${2:-}"
	tmux_apply "$1" "${2:-}"
}

system_variant() {
	case $(uname -s) in
	Darwin)
		# The key is absent entirely in light mode, hence the 2>/dev/null.
		if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null || true)" = "Dark" ]; then
			echo dark
		else
			echo light
		fi
		;;
	*)
		printf 'alacritty-theme: auto only knows how to read macOS appearance\n' >&2
		exit 1
		;;
	esac
}

# ── theme browsing ───────────────────────────────────────────────────────────

theme_files() {
	# This repo's vendored palettes first, then anything dropped into the
	# Alacritty config dir by hand, then the upstream alacritty-theme checkout.
	# Deduped by filename, first hit wins: install.sh symlinks share/colors into
	# the config dir, so without this every vendored palette appears twice.
	ls "$SHARE"/colors/*.toml "$CONFIG_DIR"/colors/*.toml \
		"$CONFIG_DIR"/themes/themes/*.toml 2>/dev/null |
		awk '{ n = $0; sub(/.*\//, "", n); if (!seen[n]++) print }'
}

# One awk pass over every theme file: pull primary bg/fg, work out whether the
# theme is light or dark and how legible it is. WCAG relative luminance, so
# "light" means what the eye means, not just a high hex value.
theme_meta() {
	# With no arguments, every installed theme; with arguments, just those.
	awk '
	function h2d(s,   i,n,d) { n=0
		for (i=1;i<=length(s);i++) { d=index("0123456789abcdef",tolower(substr(s,i,1)))-1; n=n*16+d }
		return n }
	function g1(c) { return (c<=0.03928) ? c/12.92 : ((c+0.055)/1.055)^2.4 }
	function lum(h,   r,g,b) { r=h2d(substr(h,2,2))/255; g=h2d(substr(h,4,2))/255; b=h2d(substr(h,6,2))/255
		return 0.2126*g1(r)+0.7152*g1(g)+0.0722*g1(b) }
	function contrast(a,b,   l1,l2,t) { l1=lum(a); l2=lum(b); if (l2>l1) { t=l1; l1=l2; l2=t }
		return (l1+0.05)/(l2+0.05) }
	function emit(   name,n) {
		if (prev=="" || bg=="" || fg=="") return
		n=prev; sub(/.*\//,"",n); sub(/\.toml$/,"",n)
		printf "%s\t%s\t%s\t%.2f\t%s\n", (lum(bg)>0.5 ? "light" : "dark"), bg, fg, contrast(bg,fg), prev
	}
	FILENAME != prev { emit(); prev=FILENAME; bg=""; fg=""; sect="" }
	/^\[/ { sect=$0 }
	match($0,/#[0-9a-fA-F]{6}/) { c=substr($0,RSTART,RLENGTH)
		if (sect=="[colors.primary]" && $0 ~ /background/ && bg=="") bg=c
		if (sect=="[colors.primary]" && $0 ~ /foreground/ && fg=="") fg=c }
	END { emit() }
	' ${@:-$(theme_files)}
}

# Truecolor escapes, so a swatch shows the theme's own colours no matter what
# palette the terminal is currently wearing.
rgb_esc() {
	awk -v h="${1#\#}" 'BEGIN {
		for (i=0;i<3;i++) { n=0
			for (j=1;j<=2;j++) n = n*16 + index("0123456789abcdef", tolower(substr(h,2*i+j,1))) - 1
			printf "%s%d", (i?";":""), n }
	}'
}

_swatch() {
	file=$1
	[ -f "$file" ] || return 0
	name=$(basename "$file" .toml)
	meta=$(theme_meta "$file" 2>/dev/null | head -1)
	class=$(printf '%s' "$meta" | cut -f1)
	bg=$(printf '%s' "$meta" | cut -f2)
	fg=$(printf '%s' "$meta" | cut -f3)
	cr=$(printf '%s' "$meta" | cut -f4)

	printf '\033[1m%s\033[0m\n' "$name"
	printf '\033[2m%s · %s on %s · contrast %s\033[0m\n\n' "$class" "$fg" "$bg" "$cr"

	# A line of real text in the theme's own colours beats any list of hexes.
	printf '\033[48;2;%sm\033[38;2;%sm  the quick brown fox — 0O1lI  \033[0m\n' \
		"$(rgb_esc "$bg")" "$(rgb_esc "$fg")"

	awk -v bgc="$bg" '
	/^\[/ { sect=$0 }
	match($0,/#[0-9a-fA-F]{6}/) {
		c=substr($0,RSTART,RLENGTH)
		if (sect=="[colors.normal]" || sect=="[colors.bright]") { row[sect]=row[sect] c " " }
	}
	END { printf "%s|%s\n", row["[colors.normal]"], row["[colors.bright]"] }' "$file" |
		while IFS='|' read -r normal bright; do
			for row in "$normal" "$bright"; do
				[ -n "$row" ] || continue
				printf '\033[48;2;%sm ' "$(rgb_esc "$bg")"
				for c in $row; do printf '\033[38;2;%sm███' "$(rgb_esc "$c")"; done
				printf ' \033[0m\n'
			done
		done

	printf '\n\033[2m%s\033[0m\n' "$file"
	if [ "$cr" != "" ] && [ "$(printf '%s' "$cr" | cut -d. -f1)" -lt 4 ]; then
		printf '\033[2m(under the 4.5:1 legibility floor)\033[0m\n'
	fi
}

pick() {
	variant=${1:-$(current_variant)}
	[ "$variant" = unknown ] && variant=$(system_variant)
	command -v fzf >/dev/null 2>&1 || { printf 'alacritty-theme: pick needs fzf\n' >&2; exit 1; }

	original=$(source_for "$variant")

	# Only offer themes that suit the variant being picked — a dark theme is
	# not a candidate for light mode, and offering all 156 both ways is noise.
	list=$(theme_meta | awk -F'\t' -v want="$variant" '$1==want' |
		sort -t"$(printf '\t')" -k5,5 |
		while IFS="$(printf '\t')" read -r class bg fg cr path; do
			name=$(basename "$path" .toml)
			printf '\033[38;2;%sm███\033[0m %-38s \033[2m%5s:1\033[0m\t%s\n' \
				"$(rgb_esc "$bg")" "$name" "$cr" "$path"
		done)

	chosen=$(printf '%s\n' "$list" | fzf --ansi --delimiter='\t' --with-nth=1 \
		--prompt="$variant theme > " \
		--header='live preview — enter keeps, esc restores' \
		--preview="$SELF _swatch {2}" --preview-window=right,50%,border-left \
		--bind="focus:execute-silent($SELF _preview $variant {2})" |
		cut -f2) || true

	if [ -n "$chosen" ]; then
		conf_set "$variant" "$chosen"
		set_variant "$variant" "$chosen"
		printf 'kept %s for %s\n' "$(basename "$chosen" .toml)" "$variant"
	else
		set_variant "$variant" "$original"
		printf 'restored %s\n' "$(basename "$original" .toml)"
	fi
}

current_variant() { variant_of "$THEME_FILE"; }

case "${1:-}" in
"" | status)
	# Bare invocation reports rather than errors: `theme` is an alias, and a
	# usage error is a poor answer to someone asking what is currently on.
	variant=$(current_variant)
	printf '%s\n' "$variant"
	[ "$variant" = unknown ] || printf 'alacritty: %s\n' "$(source_of "$THEME_FILE")"
	if [ -f "$TMUX_THEME_FILE" ]; then
		printf 'tmux:      %s\n' "$(source_of "$TMUX_THEME_FILE")"
	fi
	printf 'herdr:     self-switching ([theme] auto_switch, follows the terminal)\n'
	;;
dark | light) set_variant "$1" ;;
toggle)
	case $(current_variant) in
	dark) set_variant light ;;
	*) set_variant dark ;;
	esac
	;;
auto) set_variant "$(system_variant)" ;;
pick) pick "${2:-}" ;;
_preview) set_variant "$2" "$3" ;;
_swatch) _swatch "$2" ;;
-h | --help)
	sed -n '18,23p' "$0" | sed 's/^# \{0,1\}//'
	;;
*)
	sed -n '18,23p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
